{%- comment -%}
  XP desktop product tile
  Accepts: product, logo_url
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  if product.featured_media
    assign img = product.featured_media | image_url: width: 600
  else
    assign img = logo_url
  endif
-%}
<button
  class="product-item"
  type="button"
  data-product="{{ product.handle }}"
  data-title="{{ product.title | escape }}"
  data-price="{{ product.price | money | escape }}"
  data-image="{{ img | escape }}"
  data-url="{{ product.url }}"
  data-variant-id="{{ variant.id }}"
  data-available="{% if product.available %}1{% else %}0{% endif %}"
  data-sold="{% unless product.available %}1{% endunless %}"
>
  <div class="product-thumb{% unless product.available %} is-sold{% endunless %}">
    <img
      class="product-thumb__img"
      src="{{ img }}"
      alt="{{ product.featured_media.alt | default: product.title | escape }}"
      width="168"
      height="210"
      loading="lazy"
    >
  </div>
  <div class="product-name">{{ product.title }}</div>
  <div class="product-price">
    {%- if product.available -%}
      {{ product.price | money }}
    {%- else -%}
      SOLD OUT
    {%- endif -%}
  </div>
</button>
