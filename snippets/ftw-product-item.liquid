{%- comment -%}
  Corteiz-type product tile
  Accepts: product, logo_url, drop
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  if product.featured_media
    assign img = product.featured_media | image_url: width: 1200
  else
    assign img = logo_url
  endif
  assign filter_key = product.type | handleize
  if filter_key == blank
    assign filter_key = product.tags | first | handleize
  endif
  if drop == 'archive'
    assign drop_key = 'archive'
  else
    assign drop_key = 'new'
  endif
  assign desc = product.description | strip_html | truncate: 220
-%}
{%- capture variants_json -%}
[
{%- for v in product.variants -%}
  {"id":{{ v.id }},"title":{{ v.title | json }},"available":{% if v.available %}true{% else %}false{% endif %},"price":{{ v.price | money | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
{%- endcapture -%}
<a
  class="ftw-product{% unless product.available %} is-sold{% endunless %}"
  href="{{ product.url }}"
  role="listitem"
  data-product="{{ product.handle }}"
  data-title="{{ product.title | escape }}"
  data-filter="{{ filter_key }}"
  data-drop="{{ drop_key }}"
  data-price="{{ product.price | money | escape }}"
  data-image="{{ img | escape }}"
  data-url="{{ product.url }}"
  data-variant-id="{{ variant.id }}"
  data-available="{% if product.available %}1{% else %}0{% endif %}"
  data-description="{{ desc | escape }}"
  data-variants="{{ variants_json | strip | escape }}"
>
  <div class="ftw-product__media">
    <img
      src="{{ img }}"
      alt="{{ product.featured_media.alt | default: product.title | escape }}"
      width="600"
      height="720"
      loading="lazy"
    >
    {%- unless product.available -%}
      <span class="ftw-product__stamp">SOLD</span>
    {%- endunless -%}
  </div>
  <div class="ftw-product__meta">
    <span class="ftw-product__name">{{ product.title }}</span>
    <span class="ftw-product__price">
      {%- if product.available -%}
        {{ product.price | money }}
      {%- else -%}
        SOLD OUT
      {%- endif -%}
    </span>
  </div>
</a>
