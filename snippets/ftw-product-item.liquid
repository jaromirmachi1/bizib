{%- comment -%}
  Corteiz-type product tile
  Accepts: product, logo_url, drop
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  if product.featured_media
    assign img = product.featured_media | image_url: width: 1200
  else
    assign img = logo_url
  endif
  if drop == 'archive'
    assign drop_key = 'archive'
  else
    assign drop_key = 'new'
  endif
  assign desc = product.description | strip_html | truncate: 280
-%}
{%- capture collections_csv -%}
{%- for c in product.collections -%}{{ c.handle }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
{%- endcapture -%}
{%- capture options_json -%}
[
{%- for option in product.options_with_values -%}
  {"name":{{ option.name | json }},"values":{{ option.values | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
{%- endcapture -%}
{%- capture variants_json -%}
[
{%- for v in product.variants -%}
  {"id":{{ v.id }},"title":{{ v.title | json }},"available":{% if v.available %}true{% else %}false{% endif %},"price":{{ v.price | money | json }},"options":{{ v.options | json }},"image":{% if v.image %}{{ v.image | image_url: width: 1200 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
{%- endcapture -%}
{%- capture images_json -%}
[
{%- assign img_i = 0 -%}
{%- for m in product.media -%}
  {%- if m.media_type == 'image' -%}
    {%- if img_i > 0 -%},{%- endif -%}
    {{ m | image_url: width: 1600 | json }}
    {%- assign img_i = img_i | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- if img_i == 0 -%}{{ img | json }}{%- endif -%}
]
{%- endcapture -%}
{%- liquid
  assign outfit_img = ''
  for v in product.variants
    if v.image != blank
      assign outfit_img = v.image | image_url: width: 1200
      break
    endif
  endfor
-%}
<a
  class="ftw-product{% unless product.available %} is-sold{% endunless %}"
  href="{{ product.url }}"
  role="listitem"
  data-product="{{ product.handle }}"
  data-title="{{ product.title | escape }}"
  data-collections="{{ collections_csv | strip | escape }}"
  data-type="{{ product.type | escape }}"
  data-category="{{ product.category.name | escape }}"
  data-drop="{{ drop_key }}"
  data-price="{{ product.price | money | escape }}"
  data-image="{{ img | escape }}"
  data-outfit-image="{{ outfit_img | escape }}"
  data-images="{{ images_json | strip | escape }}"
  data-url="{{ product.url }}"
  data-variant-id="{{ variant.id }}"
  data-available="{% if product.available %}1{% else %}0{% endif %}"
  data-description="{{ desc | escape }}"
  data-options="{{ options_json | strip | escape }}"
  data-variants="{{ variants_json | strip | escape }}"
>
  <div class="ftw-product__media">
    <img
      src="{{ img }}"
      alt="{{ product.featured_media.alt | default: product.title | escape }}"
      width="600"
      height="720"
      loading="lazy"
      crossorigin="anonymous"
    >
    {%- if product.available -%}
      <button type="button" class="ftw-product__quick" data-ftw-quick-add aria-label="Quick add to bag">
        + ADD
      </button>
    {%- else -%}
      <span class="ftw-product__stamp">SOLD</span>
    {%- endif -%}
  </div>
  <div class="ftw-product__meta">
    <span class="ftw-product__name">{{ product.title }}</span>
    <span class="ftw-product__price">
      {%- if product.available -%}
        {{ product.price | money }}
      {%- else -%}
        SOLD OUT
      {%- endif -%}
    </span>
  </div>
</a>
