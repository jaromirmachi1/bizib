{{ 'xp-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'xp-shop.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign logo = section.settings.logo
  if logo == blank
    assign logo_url = 'panacek_2.png' | asset_url
  else
    assign logo_url = logo | image_url: width: 800
  endif
  assign live = section.settings.collection_live
  assign archive = section.settings.collection_archive
  assign ig = section.settings.instagram_url | default: 'https://www.instagram.com/biziboiz/'
-%}

<div
  class="xp-desktop desktop"
  id="desktop"
  data-cart-count="{{ cart.item_count }}"
  data-money-format="{{ shop.money_format | escape }}"
  style="--xp-wallpaper: url('{{ 'BIZI_WALLPAPERS_-_Spotlight_black_white.jpg' | asset_url }}')"
>
  <div class="bliss-brand" aria-hidden="true">
    <img class="bliss-brand__logo" src="{{ logo_url }}" alt="" width="280" height="280" loading="eager">
    <span>{{ section.settings.tagline | default: 'FOR THE WIN' }}</span>
  </div>

  <nav class="icon-grid" aria-label="Desktop applications">
    <button class="desk-icon" type="button" data-open="rules" title="BIZIBOIZ">
      <img class="desk-icon__glyph desk-icon__glyph--img" src="{{ logo_url }}" alt="" width="42" height="42">
      <span class="desk-icon__label">BIZIBOIZ</span>
    </button>
    <button class="desk-icon desk-icon--hot" type="button" data-open="shop2026">
      <svg class="desk-icon__glyph" viewBox="0 0 42 42" aria-hidden="true">
        <rect x="4" y="8" width="34" height="26" rx="2" fill="#fff" stroke="#c8c8c8"/>
        <path d="M4 14h34" stroke="#ddd" stroke-width="2"/>
        <rect x="8" y="6" width="12" height="6" rx="1" fill="#f5f5f5" stroke="#c8c8c8"/>
        <rect x="24" y="20" width="10" height="10" fill="#e10600"/>
      </svg>
      <span class="desk-icon__label">NEW DROP</span>
    </button>
    <button class="desk-icon" type="button" data-open="shop2025">
      <svg class="desk-icon__glyph" viewBox="0 0 42 42" aria-hidden="true">
        <rect x="4" y="8" width="34" height="26" rx="2" fill="#fff" stroke="#c8c8c8"/>
        <path d="M4 14h34" stroke="#ddd" stroke-width="2"/>
        <rect x="8" y="6" width="12" height="6" rx="1" fill="#f5f5f5" stroke="#c8c8c8"/>
      </svg>
      <span class="desk-icon__label">ARCHIVE</span>
    </button>
    <button class="desk-icon" type="button" data-open="wallpaper">
      <svg class="desk-icon__glyph" viewBox="0 0 42 42" aria-hidden="true">
        <rect x="4" y="8" width="34" height="26" rx="2" fill="#fff" stroke="#c8c8c8"/>
        <path d="M4 14h34" stroke="#ddd" stroke-width="2"/>
        <rect x="8" y="6" width="12" height="6" rx="1" fill="#f5f5f5" stroke="#c8c8c8"/>
        <circle cx="16" cy="22" r="3" fill="#888"/>
        <path d="M10 30l8-8 6 5 8-10 4 13H10z" fill="#bbb"/>
      </svg>
      <span class="desk-icon__label">WALLPAPER</span>
    </button>
    <button class="desk-icon" type="button" data-open="cart">
      <img
        class="desk-icon__glyph desk-icon__glyph--bag"
        src="{{ 'money_bag_only_nobg.png' | asset_url }}"
        alt=""
        width="48"
        height="38"
        loading="lazy"
        draggable="false"
      >
      <span class="desk-icon__label">THE BAG</span>
    </button>
    <button class="desk-icon" type="button" data-open="rules">
      <img
        class="desk-icon__glyph desk-icon__glyph--wanted"
        src="{{ 'wanted_bw_256.png' | asset_url }}"
        alt=""
        width="42"
        height="42"
        loading="lazy"
        draggable="false"
      >
      <span class="desk-icon__label">RULES</span>
    </button>
    <button class="desk-icon" type="button" data-open="contact">
      <img
        class="desk-icon__glyph desk-icon__glyph--letter"
        src="{{ 'letter_bw_256.png' | asset_url }}"
        alt=""
        width="42"
        height="42"
        loading="lazy"
        draggable="false"
      >
      <span class="desk-icon__label">HIT US UP</span>
    </button>
    <a class="desk-icon" href="{{ ig }}" target="_blank" rel="noopener">
      <svg class="desk-icon__glyph" viewBox="0 0 42 42" aria-hidden="true">
        <rect x="6" y="6" width="30" height="30" rx="8" fill="none" stroke="#fff" stroke-width="2.5"/>
        <circle cx="21" cy="21" r="7.5" fill="none" stroke="#fff" stroke-width="2.5"/>
        <circle cx="30" cy="13" r="2.2" fill="#fff"/>
      </svg>
      <span class="desk-icon__label">IG</span>
    </a>
  </nav>

  <div class="window-layer" id="window-layer">
    <section class="xp-window" id="win-shop2026" hidden data-window="shop2026" style="left:120px;top:40px;width:720px;height:460px">
      <header class="xp-titlebar" data-drag>
        <svg class="xp-titlebar__icon" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill="#f4d26a" stroke="#b8860b"/></svg>
        <span class="xp-titlebar__text">BIZIBOIZ.exe — LIVE DROP \\2026</span>
        <div class="xp-titlebar__controls">
          <button class="xp-ctrl" type="button" data-min aria-label="Minimize">_</button>
          <button class="xp-ctrl" type="button" data-max aria-label="Maximize">□</button>
          <button class="xp-ctrl xp-ctrl--close" type="button" data-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="xp-menubar">
        <button type="button">File</button>
        <button type="button">Edit</button>
        <button type="button">View</button>
        <button type="button">Favorites</button>
        <button type="button">Tools</button>
        <button type="button">Help</button>
      </div>
      <div class="xp-toolbar">
        <button class="xp-tool" type="button" data-open="shop2025">← Back</button>
        <button class="xp-tool" type="button" data-open="cart">Cart</button>
      </div>
      <div class="xp-address">
        <label for="addr-2026">Address</label>
        <input id="addr-2026" value="C:\BIZIBOIZ\DROPS\2026\LIVE\" readonly>
      </div>
      <div class="xp-body">
        <div class="explorer-pane">
          <aside class="explorer-side">
            <h3>Ops</h3>
            <ul>
              <li><button type="button" class="is-active" data-open="shop2026">Live Drop</button></li>
              <li><button type="button" data-open="shop2025">Deadstock / Archive</button></li>
              <li><button type="button" data-open="cart">The Bag</button></li>
              <li><button type="button" data-open="rules">Read The Rules</button></li>
            </ul>
            <p class="side-note">Limited units.<br>No restocks.<br>For the win.</p>
          </aside>
          <div class="product-grid" id="grid-2026">
            {%- if live != blank -%}
              {%- for product in live.products limit: section.settings.products_to_show -%}
                {%- render 'xp-product-item', product: product, logo_url: logo_url -%}
              {%- else -%}
                <p style="padding:20px;grid-column:1/-1">No products in this collection yet.</p>
              {%- endfor -%}
            {%- else -%}
              <p style="padding:20px;grid-column:1/-1">Pick a Live Drop collection in the theme editor.</p>
            {%- endif -%}
          </div>
        </div>
      </div>
      <footer class="xp-statusbar">
        <span>{% if live != blank %}{{ live.products_count }} pieces locked &amp; loaded{% else %}0 pieces{% endif %}</span>
        <span>MEMBERS ONLY ENERGY</span>
      </footer>
    </section>

    <section class="xp-window" id="win-shop2025" hidden data-window="shop2025" style="left:160px;top:70px;width:700px;height:440px">
      <header class="xp-titlebar" data-drag>
        <svg class="xp-titlebar__icon" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill="#e8c14a" stroke="#9a7008"/></svg>
        <span class="xp-titlebar__text">BIZIBOIZ.exe — ARCHIVE \\2025</span>
        <div class="xp-titlebar__controls">
          <button class="xp-ctrl" type="button" data-min aria-label="Minimize">_</button>
          <button class="xp-ctrl" type="button" data-max aria-label="Maximize">□</button>
          <button class="xp-ctrl xp-ctrl--close" type="button" data-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="xp-toolbar">
        <button class="xp-tool" type="button" data-open="shop2026">← Back</button>
        <button class="xp-tool" type="button" data-open="cart">Cart</button>
      </div>
      <div class="xp-address">
        <label for="addr-2025">Address</label>
        <input id="addr-2025" value="C:\BIZIBOIZ\DROPS\2025\ARCHIVE\" readonly>
      </div>
      <div class="xp-body">
        <div class="explorer-pane">
          <aside class="explorer-side">
            <h3>Vault</h3>
            <ul>
              <li><button type="button" class="is-active">2025 leftovers</button></li>
              <li><button type="button" data-open="shop2026">Back to Live</button></li>
            </ul>
            <p class="side-note">What survived.<br>What didn't get flipped.</p>
          </aside>
          <div class="product-grid" id="grid-2025">
            {%- if archive != blank -%}
              {%- for product in archive.products limit: section.settings.products_to_show -%}
                {%- render 'xp-product-item', product: product, logo_url: logo_url -%}
              {%- else -%}
                <p style="padding:20px;grid-column:1/-1">Archive empty.</p>
              {%- endfor -%}
            {%- else -%}
              <p style="padding:20px;grid-column:1/-1">Pick an Archive collection in the theme editor.</p>
            {%- endif -%}
          </div>
        </div>
      </div>
      <footer class="xp-statusbar">
        <span>{% if archive != blank %}{{ archive.products_count }} files in the vault{% else %}0 files{% endif %}</span>
        <span>ARCHIVE MODE</span>
      </footer>
    </section>

    <section class="xp-window" id="win-product" hidden data-window="product" style="left:200px;top:60px;width:640px;height:420px">
      <header class="xp-titlebar" data-drag>
        <svg class="xp-titlebar__icon" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill="#ddd" stroke="#666"/></svg>
        <span class="xp-titlebar__text" id="product-titlebar">Product.exe</span>
        <div class="xp-titlebar__controls">
          <button class="xp-ctrl" type="button" data-min aria-label="Minimize">_</button>
          <button class="xp-ctrl" type="button" data-max aria-label="Maximize">□</button>
          <button class="xp-ctrl xp-ctrl--close" type="button" data-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="xp-body" id="product-body"></div>
      <footer class="xp-statusbar"><span>Ready</span><span>BIZIBOIZ</span></footer>
    </section>

    <section class="xp-window" id="win-cart" hidden data-window="cart" style="left:180px;top:90px;width:560px;height:360px">
      <header class="xp-titlebar" data-drag>
        <svg class="xp-titlebar__icon" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill="#fff" stroke="#336"/></svg>
        <span class="xp-titlebar__text">THE BAG.exe — Checkout</span>
        <div class="xp-titlebar__controls">
          <button class="xp-ctrl" type="button" data-min aria-label="Minimize">_</button>
          <button class="xp-ctrl" type="button" data-max aria-label="Maximize">□</button>
          <button class="xp-ctrl xp-ctrl--close" type="button" data-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="xp-body" id="cart-body"></div>
    </section>

    <section class="xp-window" id="win-rules" hidden data-window="rules" style="left:240px;top:80px;width:480px;height:360px">
      <header class="xp-titlebar" data-drag>
        <svg class="xp-titlebar__icon" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill="#fffef0" stroke="#555"/></svg>
        <span class="xp-titlebar__text">Notepad — Rules.txt</span>
        <div class="xp-titlebar__controls">
          <button class="xp-ctrl" type="button" data-min aria-label="Minimize">_</button>
          <button class="xp-ctrl" type="button" data-max aria-label="Maximize">□</button>
          <button class="xp-ctrl xp-ctrl--close" type="button" data-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="xp-body">
        <div class="notepad">{{ section.settings.rules_text }}</div>
      </div>
      <footer class="xp-statusbar"><span>Ln 1, Col 1</span><span>Windows (CRLF)</span></footer>
    </section>

    <section class="xp-window" id="win-contact" hidden data-window="contact" style="left:220px;top:100px;width:460px;height:380px">
      <header class="xp-titlebar" data-drag>
        <svg class="xp-titlebar__icon" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill="#fff" stroke="#245edb"/></svg>
        <span class="xp-titlebar__text">Outlook Express — New Message</span>
        <div class="xp-titlebar__controls">
          <button class="xp-ctrl" type="button" data-min aria-label="Minimize">_</button>
          <button class="xp-ctrl" type="button" data-max aria-label="Maximize">□</button>
          <button class="xp-ctrl xp-ctrl--close" type="button" data-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="xp-body">
        <form class="contact-form" id="contact-form">
          <label>To
            <input value="{{ section.settings.contact_email | default: 'info@biziboiz.com' }}" readonly>
          </label>
          <label>From
            <input name="from" type="email" placeholder="you@email.com" required>
          </label>
          <label>Subject
            <input name="subject" type="text" placeholder="ORDER / SIZE / WHATEVER" required>
          </label>
          <label>Message
            <textarea name="message" placeholder="Keep it short..." required></textarea>
          </label>
          <button class="xp-btn xp-btn--primary" type="submit">SEND IT</button>
        </form>
      </div>
      <footer class="xp-statusbar"><span>Connected</span><span>SMTP</span></footer>
    </section>

    <section class="xp-window" id="win-wallpaper" hidden data-window="wallpaper" style="left:160px;top:60px;width:520px;height:420px">
      <header class="xp-titlebar" data-drag>
        <svg class="xp-titlebar__icon" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill="#fff" stroke="#c8c8c8"/><circle cx="5" cy="6" r="1.5" fill="#888"/><path d="M2 13l4-4 3 2 4-5 2 7H2z" fill="#bbb"/></svg>
        <span class="xp-titlebar__text">WALLPAPER.exe — Display Properties</span>
        <div class="xp-titlebar__controls">
          <button class="xp-ctrl" type="button" data-min aria-label="Minimize">_</button>
          <button class="xp-ctrl" type="button" data-max aria-label="Maximize">□</button>
          <button class="xp-ctrl xp-ctrl--close" type="button" data-close aria-label="Close">×</button>
        </div>
      </header>
      <div class="xp-body">
        <div class="wallpaper-panel">
          <p class="wallpaper-panel__copy">Pick a desktop background. Leftover screen space stays black.</p>
          <div class="wallpaper-grid">
            <button
              class="wallpaper-tile is-active"
              type="button"
              data-wallpaper="{{ 'BIZI_WALLPAPERS_-_Spotlight_black_white.jpg' | asset_url }}"
              data-wallpaper-name="Spotlight"
            >
              <img
                src="{{ 'BIZI_WALLPAPERS_-_Spotlight_black_white.jpg' | asset_url }}"
                alt=""
                width="120"
                height="160"
                loading="lazy"
                draggable="false"
              >
              <span>Spotlight</span>
            </button>
          </div>
          <button class="xp-btn xp-btn--primary" type="button" id="wallpaper-apply">APPLY TO DESKTOP</button>
        </div>
      </div>
      <footer class="xp-statusbar"><span>1 wallpaper</span><span>CONTAIN + BLACK</span></footer>
    </section>

    {%- liquid
      assign orders = 0
      assign points = 0
      assign rank_name = 'RECRUIT'
      assign rank_next = 'SOLDIER'
      assign rank_need = 1
      assign rank_progress = 0
      if customer
        assign orders = customer.orders_count
        assign points = orders | times: 150 | plus: 50
        if orders >= 12
          assign rank_name = 'LEGEND'
          assign rank_next = 'MAX'
          assign rank_need = 12
          assign rank_progress = 100
        elsif orders >= 6
          assign rank_name = 'GENERAL'
          assign rank_next = 'LEGEND'
          assign rank_need = 12
          assign rank_progress = orders | minus: 6 | times: 100 | divided_by: 6
        elsif orders >= 3
          assign rank_name = 'CAPTAIN'
          assign rank_next = 'GENERAL'
          assign rank_need = 6
          assign rank_progress = orders | minus: 3 | times: 100 | divided_by: 3
        elsif orders >= 1
          assign rank_name = 'SOLDIER'
          assign rank_next = 'CAPTAIN'
          assign rank_need = 3
          assign rank_progress = orders | minus: 1 | times: 100 | divided_by: 2
        else
          assign rank_name = 'RECRUIT'
          assign rank_next = 'SOLDIER'
          assign rank_need = 1
          assign rank_progress = 0
        endif
      endif
    -%}

  </div>

  <div class="account-menu" id="account-menu" hidden role="dialog" aria-label="Account">
    {%- if customer -%}
      <div class="account-menu__header">
        <div class="account-menu__avatar">{{ customer.first_name | default: customer.email | slice: 0 | upcase }}</div>
        <div class="account-menu__who">
          <div class="account-menu__name">{{ customer.name | default: customer.email }}</div>
          <div class="account-menu__email">{{ customer.email }}</div>
        </div>
        <div class="account-menu__badge">{{ rank_name }}</div>
      </div>

      <div class="account-menu__tabs" role="tablist">
        <button class="account-tab is-active" type="button" role="tab" aria-selected="true" data-account-tab="loyalty">Loyalty</button>
        <button class="account-tab" type="button" role="tab" aria-selected="false" data-account-tab="orders">Orders</button>
        <button class="account-tab" type="button" role="tab" aria-selected="false" data-account-tab="account">Account</button>
      </div>

      <div class="account-menu__body">
        <div class="account-panel is-active" data-account-panel="loyalty" role="tabpanel">
          <div class="xp-account__stats">
            <div class="xp-stat">
              <span class="xp-stat__label">LOYALTY PTS</span>
              <span class="xp-stat__value">{{ points }}</span>
            </div>
            <div class="xp-stat">
              <span class="xp-stat__label">DROPS</span>
              <span class="xp-stat__value">{{ orders }}</span>
            </div>
            <div class="xp-stat">
              <span class="xp-stat__label">SPENT</span>
              <span class="xp-stat__value">{{ customer.total_spent | money }}</span>
            </div>
          </div>
          <div class="xp-account__progress">
            <div class="xp-account__progress-top">
              <span>RANK: {{ rank_name }}</span>
              {%- if rank_next != 'MAX' -%}
                <span>NEXT: {{ rank_next }}</span>
              {%- else -%}
                <span>MAX RANK</span>
              {%- endif -%}
            </div>
            <div class="xp-account__bar">
              <div class="xp-account__bar-fill" style="width: {{ rank_progress }}%"></div>
            </div>
          </div>
          <div class="xp-account__ladder">
            <div class="xp-rank{% if rank_name == 'RECRUIT' %} is-current{% endif %}">RECRUIT</div>
            <div class="xp-rank{% if rank_name == 'SOLDIER' %} is-current{% endif %}">SOLDIER</div>
            <div class="xp-rank{% if rank_name == 'CAPTAIN' %} is-current{% endif %}">CAPTAIN</div>
            <div class="xp-rank{% if rank_name == 'GENERAL' %} is-current{% endif %}">GENERAL</div>
            <div class="xp-rank{% if rank_name == 'LEGEND' %} is-current{% endif %}">LEGEND</div>
          </div>
        </div>

        <div class="account-panel" data-account-panel="orders" role="tabpanel" hidden>
          <div class="account-orders">
            {%- if customer.orders_count > 0 -%}
              {%- for order in customer.orders limit: 5 -%}
                <a class="account-order" href="{{ order.customer_url }}">
                  <span class="account-order__id">{{ order.name }}</span>
                  <span class="account-order__meta">{{ order.created_at | date: '%d %b %Y' }} · {{ order.item_count }} {% if order.item_count == 1 %}item{% else %}items{% endif %}</span>
                  <span class="account-order__price">{{ order.total_price | money }}</span>
                  <span class="account-order__status">{{ order.fulfillment_status_label | default: order.financial_status_label }}</span>
                </a>
              {%- endfor -%}
            {%- else -%}
              <p class="xp-account__guest-copy">No orders yet. Secure a drop.</p>
            {%- endif -%}
          </div>
          <a class="xp-btn xp-btn--primary account-panel__cta" href="{{ routes.account_url }}">VIEW ALL ORDERS</a>
        </div>

        <div class="account-panel" data-account-panel="account" role="tabpanel" hidden>
          <dl class="account-info">
            <div class="account-info__row">
              <dt>Name</dt>
              <dd>{{ customer.name | default: '—' }}</dd>
            </div>
            <div class="account-info__row">
              <dt>Email</dt>
              <dd>{{ customer.email }}</dd>
            </div>
            <div class="account-info__row">
              <dt>Phone</dt>
              <dd>{{ customer.phone | default: '—' }}</dd>
            </div>
            <div class="account-info__row">
              <dt>Addresses</dt>
              <dd>{{ customer.addresses_count }} saved</dd>
            </div>
            {%- if customer.default_address -%}
              <div class="account-info__row">
                <dt>Ship to</dt>
                <dd>{{ customer.default_address.city }}{% if customer.default_address.country %}, {{ customer.default_address.country }}{% endif %}</dd>
              </div>
            {%- endif -%}
          </dl>
          <div class="account-panel__actions">
            <a class="xp-btn xp-btn--primary" href="{{ routes.account_url }}">EDIT ACCOUNT</a>
            <a class="xp-btn" href="{{ routes.account_addresses_url }}">ADDRESSES</a>
          </div>
        </div>
      </div>

      <div class="account-menu__footer">
        <a class="xp-btn" href="{{ routes.account_logout_url }}">LOG OUT</a>
      </div>
    {%- else -%}
      <div class="account-menu__header">
        <div class="account-menu__avatar">?</div>
        <div class="account-menu__who">
          <div class="account-menu__name">GUEST</div>
          <div class="account-menu__email">Join to unlock loyalty</div>
        </div>
        <div class="account-menu__badge">LOCKED</div>
      </div>

      <div class="account-menu__tabs" role="tablist">
        <button class="account-tab is-active" type="button" role="tab" aria-selected="true" data-account-tab="loyalty">Loyalty</button>
        <button class="account-tab" type="button" role="tab" aria-selected="false" data-account-tab="orders">Orders</button>
        <button class="account-tab" type="button" role="tab" aria-selected="false" data-account-tab="account">Account</button>
      </div>

      <div class="account-menu__body">
        <div class="account-panel is-active" data-account-panel="loyalty" role="tabpanel">
          <p class="xp-account__guest-copy">Log in to track points, climb ranks, and unlock drop priority.</p>
          <div class="xp-account__stats xp-account__stats--preview">
            <div class="xp-stat">
              <span class="xp-stat__label">LOYALTY PTS</span>
              <span class="xp-stat__value">—</span>
            </div>
            <div class="xp-stat">
              <span class="xp-stat__label">RANK</span>
              <span class="xp-stat__value">LOCKED</span>
            </div>
          </div>
          <div class="xp-account__ladder">
            <div class="xp-rank">RECRUIT</div>
            <div class="xp-rank">SOLDIER</div>
            <div class="xp-rank">CAPTAIN</div>
            <div class="xp-rank">GENERAL</div>
            <div class="xp-rank">LEGEND</div>
          </div>
        </div>

        <div class="account-panel" data-account-panel="orders" role="tabpanel" hidden>
          <p class="xp-account__guest-copy">Sign in to see your old orders and tracking.</p>
          <a class="xp-btn xp-btn--primary account-panel__cta" href="{{ routes.account_login_url }}">LOG IN FOR ORDERS</a>
        </div>

        <div class="account-panel" data-account-panel="account" role="tabpanel" hidden>
          <p class="xp-account__guest-copy">Create an account to save addresses and manage your profile.</p>
          <div class="account-panel__actions">
            <a class="xp-btn xp-btn--primary" href="{{ routes.account_login_url }}">LOG IN</a>
            <a class="xp-btn" href="{{ routes.account_register_url }}">CREATE</a>
          </div>
        </div>
      </div>

      <div class="account-menu__footer">
        <a class="xp-btn xp-btn--primary" href="{{ routes.account_login_url }}">LOG IN</a>
        <a class="xp-btn" href="{{ routes.account_register_url }}">CREATE</a>
      </div>
    {%- endif -%}
  </div>

  <div class="xp-toast" id="toast" role="status" aria-live="polite">
    <div class="xp-toast__bar">BIZIBOIZ</div>
    <div class="xp-toast__body" id="toast-body">Added to cart.</div>
  </div>

  <div class="taskbar" role="contentinfo">
    <button class="start-btn" type="button" id="start-btn" aria-expanded="false" aria-controls="account-menu" aria-label="Open account">
      <img class="start-logo start-logo--biziboiz" src="{{ logo_url }}" alt="" width="20" height="20">
      account
    </button>
    <div class="task-buttons" id="task-buttons"></div>
    <button class="tray tray--cart" type="button" id="tray-cart" data-open="cart" aria-label="Open cart">
      <img
        class="tray-cart__icon"
        src="{{ 'money_bag_only_nobg.png' | asset_url }}"
        alt=""
        width="20"
        height="16"
        loading="lazy"
        draggable="false"
      >
      <span class="tray-cart__label">BAG</span>
      <span class="tray-cart__count" id="cart-count">{{ cart.item_count }}</span>
    </button>
  </div>
</div>

