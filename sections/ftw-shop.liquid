{{ 'ftw-shop.css' | asset_url | stylesheet_tag }}
<script>
  (function () {
    try {
      var t = localStorage.getItem('ftw-theme');
      if (t !== 'dark' && t !== 'light') t = 'light';
      document.documentElement.setAttribute('data-ftw-theme', t);
    } catch (e) {
      document.documentElement.setAttribute('data-ftw-theme', 'light');
    }
  })();
</script>
<script src="{{ 'ftw-shop.js' | asset_url }}" defer="defer"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- liquid
  assign logo = section.settings.logo
  assign logo_dark_url = 'panacek-3-white.png' | asset_url
  if logo == blank
    assign logo_url = 'panacek-3-black.png' | asset_url
  else
    assign logo_url = logo | image_url: width: 400
  endif
  assign live = section.settings.collection_live
  assign archive = section.settings.collection_archive
  assign upsell = section.settings.collection_upsell
  if upsell == blank
    assign upsell = live
  endif
  assign upsell_heading = section.settings.upsell_heading | default: 'ADD THIS TOO'
  assign upsell_limit = section.settings.upsell_limit | default: 2
  assign ig = section.settings.instagram_url | default: 'https://www.instagram.com/biziboiz/'
  assign limit = section.settings.products_to_show
  assign show_announce = section.settings.show_announce
  assign announce_link = section.settings.announce_link
  assign announce_speed = section.settings.announce_speed | default: 36
  assign announce_count = 0
  for block in section.blocks
    if block.type == 'announce' and block.settings.text != blank
      assign announce_count = announce_count | plus: 1
    endif
  endfor
  if show_announce and announce_count == 0
    assign announce_count = 4
  endif

  assign orders = 0
  assign points = 0
  assign rank_name = 'RECRUIT'
  assign rank_next = 'SOLDIER'
  assign rank_progress = 0
  if customer
    assign orders = customer.orders_count
    assign points = orders | times: 150 | plus: 50
    if orders >= 12
      assign rank_name = 'LEGEND'
      assign rank_next = 'MAX'
      assign rank_progress = 100
    elsif orders >= 6
      assign rank_name = 'GENERAL'
      assign rank_next = 'LEGEND'
      assign rank_progress = orders | minus: 6 | times: 100 | divided_by: 6
    elsif orders >= 3
      assign rank_name = 'CAPTAIN'
      assign rank_next = 'GENERAL'
      assign rank_progress = orders | minus: 3 | times: 100 | divided_by: 3
    elsif orders >= 1
      assign rank_name = 'SOLDIER'
      assign rank_next = 'CAPTAIN'
      assign rank_progress = orders | minus: 1 | times: 100 | divided_by: 2
    endif
  endif
-%}

<div
  class="ftw-shop{% if show_announce and announce_count > 0 %} ftw-shop--announce{% endif %}"
  id="ftw-shop"
  data-cart-count="{{ cart.item_count }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-upsell-heading="{{ upsell_heading | escape }}"
  data-upsell-limit="{{ upsell_limit }}"
  data-figure-light="{{ logo_url | escape }}"
  data-figure-dark="{{ logo_dark_url | escape }}"
  {% if show_announce and announce_count > 0 %}style="--ftw-announce-speed: {{ announce_speed }}s;"{% endif %}
>
  {%- if show_announce and announce_count > 0 -%}
    <div class="ftw-announce" role="region" aria-label="Announcement">
      {%- if announce_link != blank -%}
        <a class="ftw-announce__hit" href="{{ announce_link }}"></a>
      {%- endif -%}
      <span class="ftw-announce__live" aria-hidden="true">
        <span class="ftw-announce__dot"></span>
        LIVE
      </span>
      <div class="ftw-announce__viewport">
        <div class="ftw-announce__track">
          {%- for i in (1..2) -%}
            <div class="ftw-announce__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
              {%- assign rendered_announce = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'announce' and block.settings.text != blank -%}
                  <span class="ftw-announce__item" {{ block.shopify_attributes }}>{{ block.settings.text | upcase | escape }}</span>
                  <span class="ftw-announce__sep" aria-hidden="true">//</span>
                  {%- assign rendered_announce = rendered_announce | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if rendered_announce == 0 -%}
                <span class="ftw-announce__item">BIZIBOIZ — NEW DROP LIVE</span>
                <span class="ftw-announce__sep" aria-hidden="true">//</span>
                <span class="ftw-announce__item">FREE CZ SHIPPING OVER 1500 KČ</span>
                <span class="ftw-announce__sep" aria-hidden="true">//</span>
                <span class="ftw-announce__item">LIMITED RUNS — NO RESTOCKS</span>
                <span class="ftw-announce__sep" aria-hidden="true">//</span>
                <span class="ftw-announce__item">FOLLOW @BIZIBOIZ</span>
                <span class="ftw-announce__sep" aria-hidden="true">//</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="ftw-nav-scrim" id="ftw-nav-scrim" hidden></div>

  <div class="ftw-shell">
    <aside class="ftw-side" id="ftw-side" aria-label="Shop navigation">
      <a class="ftw-logo" href="{{ routes.root_url }}" aria-label="BIZIBOIZ home">
        <img class="ftw-logo__light" src="{{ logo_url }}" alt="" width="280" height="280">
        <img class="ftw-logo__dark" src="{{ logo_dark_url }}" alt="" width="280" height="280">
      </a>

      <nav class="ftw-cats" aria-label="Categories">
        <button type="button" class="is-active" data-ftw-filter="all">NEW</button>
        {%- assign ftw_cat_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            {%- liquid
              assign cat = block.settings.collection
              assign cat_label = block.settings.label
              assign try_handle = ''
              if cat_label == blank and cat != blank
                assign cat_label = cat.title
              endif
              if cat == blank and cat_label != blank
                assign try_handle = cat_label | handleize
                assign cat = collections[try_handle]
              endif
              if cat == blank and try_handle == 'hoodies-sweatshirts'
                assign cat = collections['hoodies']
              endif
              if cat_label == blank and cat != blank
                assign cat_label = cat.title
              endif
              if cat != blank
                assign filter_key = cat.handle
              elsif cat_label != blank
                assign filter_key = cat_label | handleize
              else
                assign filter_key = ''
              endif
            -%}
            {%- if filter_key != blank -%}
              <button
                type="button"
                data-ftw-filter="{{ filter_key | escape }}"
                {{ block.shopify_attributes }}
              >
                {{ cat_label | upcase }}
              </button>
              {%- assign ftw_cat_count = ftw_cat_count | plus: 1 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if ftw_cat_count == 0 -%}
          {%- assign ftw_fallback_cats = 'Jackets:jackets|Bottoms:bottoms|Hats:hats|Hoodies & Sweatshirts:hoodies-sweatshirts|T-Shirts:t-shirts|Womens:womens|Lifestyle:lifestyle|Accessories:accessories' | split: '|' -%}
          {%- for entry in ftw_fallback_cats -%}
            {%- assign parts = entry | split: ':' -%}
            {%- assign cat_label = parts[0] -%}
            {%- assign try_handle = parts[1] -%}
            {%- assign cat = collections[try_handle] -%}
            {%- if cat == blank and try_handle == 'hoodies-sweatshirts' -%}
              {%- assign cat = collections['hoodies'] -%}
            {%- endif -%}
            {%- if cat != blank -%}
              {%- assign filter_key = cat.handle -%}
            {%- else -%}
              {%- assign filter_key = try_handle -%}
            {%- endif -%}
            <button type="button" data-ftw-filter="{{ filter_key | escape }}">
              {{ cat_label | upcase }}
            </button>
          {%- endfor -%}
        {%- endif -%}
        <button type="button" data-ftw-filter="archive">ARCHIVE</button>
      </nav>

      <div class="ftw-side__foot">
        <div class="ftw-side__icons">
          <a href="{{ ig }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <button type="button" id="ftw-account-btn" aria-expanded="false" aria-controls="ftw-account" aria-label="Account">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="8" r="3.2"></circle>
              <path d="M5 19c1.8-3.2 4-4.8 7-4.8s5.2 1.6 7 4.8"></path>
            </svg>
          </button>
          <button
            type="button"
            class="ftw-theme-btn"
            id="ftw-theme-btn"
            aria-pressed="false"
            aria-label="Switch to dark mode"
          >
            <svg class="ftw-theme-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
              <path d="M12 3.8a8.2 8.2 0 0 1 0 16.4Z" fill="currentColor"></path>
            </svg>
          </button>
        </div>
        <div class="ftw-side__links">
          <button type="button" data-ftw-filter="archive">ARCHIVE</button>
          <button type="button" id="ftw-contact-open">NEWSLETTER</button>
          <a href="/policies/shipping-policy">SHIPPING POLICY</a>
          <a href="/policies/terms-of-service">TERMS OF SERVICE</a>
        </div>
      </div>
    </aside>

    <div class="ftw-main">
      <header class="ftw-top">
        <button class="ftw-top__item ftw-menu-btn" type="button" id="ftw-menu-btn" aria-label="Open menu" aria-controls="ftw-side">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          MENU
        </button>
        <label class="ftw-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="M16.5 16.5L21 21"></path>
          </svg>
          <input type="search" id="ftw-search-input" placeholder="SEARCH" autocomplete="off" aria-label="Search products">
        </label>
        <button class="ftw-top__item" type="button" id="ftw-bag-btn" aria-expanded="false" aria-controls="ftw-bag">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M6.5 8.5h11l-.8 11.2a1.5 1.5 0 0 1-1.5 1.3H8.8a1.5 1.5 0 0 1-1.5-1.3L6.5 8.5Z"></path>
            <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"></path>
          </svg>
          CART (<span id="cart-count">{{ cart.item_count }}</span>)
        </button>
        <button class="ftw-top__item" type="button" id="ftw-account-top-btn" aria-expanded="false" aria-controls="ftw-account">
          ACCOUNT
        </button>
      </header>

      <h1 class="visually-hidden">BIZIBOIZ Shop</h1>

      <div class="ftw-grid" id="ftw-grid" role="list">
        {%- assign seen = '|' -%}
        {%- assign rendered = 0 -%}

        {%- if live != blank -%}
          {%- for product in live.products limit: limit -%}
            {%- assign key = product.handle | prepend: '|' | append: '|' -%}
            {%- unless seen contains key -%}
              {%- render 'ftw-product-item', product: product, logo_url: logo_url, drop: 'new' -%}
              {%- assign seen = seen | append: product.handle | append: '|' -%}
              {%- assign rendered = rendered | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            {%- liquid
              assign cat = block.settings.collection
              assign try_handle = ''
              if cat == blank and block.settings.label != blank
                assign try_handle = block.settings.label | handleize
                assign cat = collections[try_handle]
              endif
              if cat == blank and try_handle == 'hoodies-sweatshirts'
                assign cat = collections['hoodies']
              endif
            -%}
            {%- if cat != blank -%}
              {%- for product in cat.products limit: limit -%}
                {%- assign key = product.handle | prepend: '|' | append: '|' -%}
                {%- unless seen contains key -%}
                  {%- render 'ftw-product-item', product: product, logo_url: logo_url, drop: 'new' -%}
                  {%- assign seen = seen | append: product.handle | append: '|' -%}
                  {%- assign rendered = rendered | plus: 1 -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if archive != blank -%}
          {%- for product in archive.products limit: limit -%}
            {%- assign key = product.handle | prepend: '|' | append: '|' -%}
            {%- unless seen contains key -%}
              {%- render 'ftw-product-item', product: product, logo_url: logo_url, drop: 'archive' -%}
              {%- assign seen = seen | append: product.handle | append: '|' -%}
              {%- assign rendered = rendered | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if rendered == 0 -%}
          <p class="ftw-empty">Connect collections in the theme editor (NEW + category blocks).</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="ftw-drawer" id="ftw-bag" hidden>
    <div class="ftw-drawer__panel">
      <header class="ftw-drawer__head">
        <h2>CART</h2>
        <button class="ftw-drawer__close" type="button" data-close-drawer aria-label="Close cart">×</button>
      </header>
      <div class="ftw-drawer__body" id="cart-body">
        <div class="ftw-empty">CART EMPTY.</div>
      </div>
      <div class="ftw-upsell" id="cart-upsell" hidden></div>
      <div class="cart-footer" id="cart-footer" hidden></div>
    </div>
  </div>

  <div class="ftw-drawer" id="ftw-account" hidden>
    <div class="ftw-drawer__panel">
      <header class="ftw-drawer__head">
        <h2>ACCOUNT</h2>
        <button class="ftw-drawer__close" type="button" data-close-drawer aria-label="Close account">×</button>
      </header>
      <div class="ftw-drawer__tabs" role="tablist">
        <button class="ftw-tab is-active" type="button" data-ftw-tab="loyalty">Loyalty</button>
        <button class="ftw-tab" type="button" data-ftw-tab="orders">Orders</button>
        <button class="ftw-tab" type="button" data-ftw-tab="account">Account</button>
      </div>
      <div class="ftw-drawer__body">
        {%- if customer -%}
          <div class="ftw-panel is-active" data-ftw-panel="loyalty">
            <div class="ftw-rank">
              <span class="ftw-rank__badge">{{ rank_name }}</span>
              <span>{{ points }} PTS · {{ orders }} DROPS</span>
            </div>
            <div class="ftw-bar"><div class="ftw-bar__fill" style="width:{{ rank_progress }}%"></div></div>
            <p class="ftw-muted">{% if rank_next != 'MAX' %}Next: {{ rank_next }}{% else %}MAX RANK{% endif %}</p>
            <div class="ftw-ladder">
              <span{% if rank_name == 'RECRUIT' %} class="is-on"{% endif %}>RECRUIT</span>
              <span{% if rank_name == 'SOLDIER' %} class="is-on"{% endif %}>SOLDIER</span>
              <span{% if rank_name == 'CAPTAIN' %} class="is-on"{% endif %}>CAPTAIN</span>
              <span{% if rank_name == 'GENERAL' %} class="is-on"{% endif %}>GENERAL</span>
              <span{% if rank_name == 'LEGEND' %} class="is-on"{% endif %}>LEGEND</span>
            </div>
          </div>
          <div class="ftw-panel" data-ftw-panel="orders" hidden>
            {%- if customer.orders_count > 0 -%}
              <ul class="ftw-orders">
                {%- for order in customer.orders limit: 5 -%}
                  <li>
                    <a href="{{ order.customer_url }}">
                      <strong>{{ order.name }}</strong>
                      <span>{{ order.created_at | date: '%d %b %Y' }} · {{ order.total_price | money }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
              <a class="ftw-btn ftw-btn--primary" href="{{ routes.account_url }}">VIEW ALL ORDERS</a>
            {%- else -%}
              <p class="ftw-empty">No orders yet.</p>
            {%- endif -%}
          </div>
          <div class="ftw-panel" data-ftw-panel="account" hidden>
            <dl class="ftw-info">
              <div><dt>Name</dt><dd>{{ customer.name | default: '—' }}</dd></div>
              <div><dt>Email</dt><dd>{{ customer.email }}</dd></div>
              <div><dt>Phone</dt><dd>{{ customer.phone | default: '—' }}</dd></div>
              <div><dt>Addresses</dt><dd>{{ customer.addresses_count }} saved</dd></div>
            </dl>
            <div class="ftw-actions">
              <a class="ftw-btn ftw-btn--primary" href="{{ routes.account_url }}">EDIT ACCOUNT</a>
              <a class="ftw-btn" href="{{ routes.account_logout_url }}">LOG OUT</a>
            </div>
          </div>
        {%- else -%}
          <div class="ftw-panel is-active" data-ftw-panel="loyalty">
            <p class="ftw-empty">Log in to track loyalty points.</p>
            <div class="ftw-ladder">
              <span>RECRUIT</span><span>SOLDIER</span><span>CAPTAIN</span><span>GENERAL</span><span>LEGEND</span>
            </div>
          </div>
          <div class="ftw-panel" data-ftw-panel="orders" hidden>
            <p class="ftw-empty">Sign in to see orders.</p>
          </div>
          <div class="ftw-panel" data-ftw-panel="account" hidden>
            <div class="ftw-actions">
              <a class="ftw-btn ftw-btn--primary" href="{{ routes.account_login_url }}">LOG IN</a>
              <a class="ftw-btn" href="{{ routes.account_register_url }}">CREATE</a>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="ftw-drawer" id="ftw-contact" hidden>
    <div class="ftw-drawer__panel">
      <header class="ftw-drawer__head">
        <h2>NEWSLETTER</h2>
        <button class="ftw-drawer__close" type="button" data-close-drawer aria-label="Close">×</button>
      </header>
      <div class="ftw-drawer__body">
        <form class="ftw-contact" id="contact-form">
          <label>Email
            <input name="from" type="email" placeholder="you@email.com" required>
          </label>
          <button class="ftw-btn ftw-btn--primary" type="submit">JOIN</button>
        </form>
      </div>
    </div>
  </div>

  <div class="ftw-sheet" id="ftw-sheet" hidden>
    <div
      class="ftw-sheet__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ftw-sheet-title"
    >
      <button class="ftw-sheet__back" type="button" data-close-sheet>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path d="M15 5L8 12l7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        BACK
      </button>

      <div class="ftw-sheet__layout">
        <div class="ftw-sheet__stage" id="ftw-sheet-stack"></div>

        <aside class="ftw-sheet__side">
          <div class="ftw-sheet__side-top">
            <h2 id="ftw-sheet-title"></h2>
            <p class="ftw-sheet__price" id="ftw-sheet-price"></p>
            <ul class="ftw-sheet__lines" id="ftw-sheet-lines"></ul>
            <p class="ftw-sheet__note" id="ftw-sheet-note">LIMITED DROP. NO RESTOCKS.</p>

            <div class="ftw-sheet__options" id="ftw-sheet-sizes"></div>

            <button class="ftw-sheet__add" type="button" id="ftw-sheet-add">ADD TO CART</button>

            <div class="ftw-sheet__links">
              <button type="button" class="ftw-sheet__link" data-ftw-detail="tech">
                TECHNICAL DETAILS <span aria-hidden="true">▸</span>
              </button>
              <div class="ftw-sheet__detail" data-ftw-detail-panel="tech" hidden>
                Heavyweight build. Street cut. Wear it, don't warehouse it.
              </div>
              <button type="button" class="ftw-sheet__link" data-ftw-detail="size">
                SIZE CHART <span aria-hidden="true">▸</span>
              </button>
              <div class="ftw-sheet__detail" data-ftw-detail-panel="size" hidden>
                S / M / L / XL — true to size. Size up for oversized.
              </div>
            </div>
          </div>

        </aside>
      </div>
    </div>
  </div>

  <div class="ftw-outfit" id="ftw-outfit" hidden>
    <div class="ftw-outfit__panel" role="dialog" aria-modal="true" aria-labelledby="ftw-outfit-title">
      <header class="ftw-outfit__head">
        <h2 id="ftw-outfit-title">OUTFIT CHECKER</h2>
        <div class="ftw-outfit__head-actions">
          <button type="button" class="ftw-outfit__clear" id="ftw-outfit-clear">CLEAR</button>
          <button type="button" class="ftw-outfit__close" id="ftw-outfit-close" aria-label="Close outfit checker">×</button>
        </div>
      </header>
      <div class="ftw-outfit__body">
        <aside class="ftw-outfit__rack" aria-label="Pieces">
          <div class="ftw-outfit__rack-label">DRAG PIECES</div>
          <div class="ftw-outfit__rack-list" id="ftw-outfit-rack"></div>
        </aside>
        <div class="ftw-outfit__stage" id="ftw-outfit-stage">
          <img
            class="ftw-outfit__figure ftw-outfit__figure--light"
            src="{{ logo_url }}"
            alt=""
            width="320"
            height="400"
            draggable="false"
          >
          <img
            class="ftw-outfit__figure ftw-outfit__figure--dark"
            src="{{ logo_dark_url }}"
            alt=""
            width="320"
            height="400"
            draggable="false"
          >
          <p class="ftw-outfit__hint" id="ftw-outfit-hint">DROP ITEMS ON THE FIGURE</p>
        </div>
      </div>
    </div>
  </div>

  <div class="ftw-toast" id="toast" role="status" aria-live="polite">
    <div id="toast-body">Added to cart.</div>
  </div>

  {%- capture ftw_upsell_json -%}
[
{%- assign upsell_i = 0 -%}
{%- if upsell != blank -%}
  {%- for product in upsell.products limit: 12 -%}
    {%- if product.available -%}
      {%- assign uv = product.selected_or_first_available_variant -%}
      {%- if upsell_i > 0 -%},{%- endif -%}
      {
        "id":{{ product.id }},
        "handle":{{ product.handle | json }},
        "title":{{ product.title | json }},
        "price":{{ product.price | money | json }},
        "image":{% if product.featured_media %}{{ product.featured_media | image_url: width: 240 | json }}{% else %}{{ logo_url | json }}{% endif %},
        "variantId":{{ uv.id }},
        "available":true
      }
      {%- assign upsell_i = upsell_i | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
]
  {%- endcapture -%}
  <script type="application/json" id="ftw-upsell-data">{{ ftw_upsell_json | strip }}</script>
</div>

